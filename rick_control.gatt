PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "Rick Pico 2 W"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// State and telemetry reads do not change the robot and remain available
// before pairing. Writes require a 16-byte encryption key, which lets Android
// pair on demand when the user sends the first command.
PRIMARY_SERVICE, 7E57A001-4C91-4D8E-8F2A-7DCA6D5A1000
// A002: one-byte control command/state.
CHARACTERISTIC, 7E57A002-4C91-4D8E-8F2A-7DCA6D5A1000, READ | WRITE | DYNAMIC | READ_ANYBODY | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
// A003: six signed 16-bit IMU telemetry values.
CHARACTERISTIC, 7E57A003-4C91-4D8E-8F2A-7DCA6D5A1000, READ | DYNAMIC,
// A004: eight uint16 centers on read; servo index + int16 delta on write.
CHARACTERISTIC, 7E57A004-4C91-4D8E-8F2A-7DCA6D5A1000, READ | WRITE | DYNAMIC | READ_ANYBODY | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
// A005: OTA begin/abort/commit control packets.
CHARACTERISTIC, 7E57A005-4C91-4D8E-8F2A-7DCA6D5A1000, WRITE | DYNAMIC | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
// A006: offset-prefixed OTA data chunks (compact flash payloads in protocol v2).
CHARACTERISTIC, 7E57A006-4C91-4D8E-8F2A-7DCA6D5A1000, WRITE | DYNAMIC | WRITE_ENCRYPTED | ENCRYPTION_KEY_SIZE_16,
// A007: protocol/state/error plus byte and block progress.
CHARACTERISTIC, 7E57A007-4C91-4D8E-8F2A-7DCA6D5A1000, READ | DYNAMIC,
