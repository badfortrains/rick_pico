PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "Rick Pico 2 W"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// Encrypted read/write access makes Android complete BLE pairing before a
// control command can reach the robot.
PRIMARY_SERVICE, 7E57A001-4C91-4D8E-8F2A-7DCA6D5A1000
// A002: one-byte control command/state.
CHARACTERISTIC, 7E57A002-4C91-4D8E-8F2A-7DCA6D5A1000, READ | WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,
// A003: six signed 16-bit IMU telemetry values.
CHARACTERISTIC, 7E57A003-4C91-4D8E-8F2A-7DCA6D5A1000, READ | DYNAMIC | ENCRYPTION_KEY_SIZE_16,
// A004: eight uint16 centers on read; servo index + int16 delta on write.
CHARACTERISTIC, 7E57A004-4C91-4D8E-8F2A-7DCA6D5A1000, READ | WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16,
